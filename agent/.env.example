# ===== leomall 集成：服务绑定与内部鉴权 =====
# 只监听回环地址，Java BFF 走 127.0.0.1 内网调用；不要改成 0.0.0.0 暴露到公网。
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data
# BFF 调用 /commerce/intents 时必须带 X-Internal-Token，值需与
# leomall 的 leomall.agent.internal-token 完全一致；留空 = 不校验（仅本机开发）。
INTERNAL_API_TOKEN=leomall-agent-dev-2026
# 关闭跨境订单工具：下单统一走 leomall 原生购物车/结算流程
ENABLE_TRADE_TOOLS=0
# 1 = 强制使用本地确定性推荐（不调 LLM）；未配 LLM_API_KEY 时会自动置为 1
LOCAL_FALLBACK=0

# ===== 商品目录快照（leomall MySQL 导出）=====
# 由 `uv run python scripts/export_leomall_catalog.py` 生成，
# 改价/上下架后重跑脚本并重启服务；导出参数用 LEOMALL_MYSQL_* 环境变量。
# LEOMALL_CATALOG_PATH=./data/leomall_catalog.json

# ===== LLM (OpenAI 兼容协议，需以 /v1 结尾) =====
# 敏感项推荐通过环境变量注入，不要写进版本库：
#   export LLM_BASE_URL=<网关地址> LLM_API_KEY=<密钥>
# 不配置 LLM_API_KEY 也能启动：自动进入 LOCAL_FALLBACK 确定性推荐模式。
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-v4.1-flash
# LLM_FALLBACK_MODEL=

# ===== Embedding (OpenAI 兼容 /v1/embeddings，缺省复用 LLM_* 网关) =====
# 无 embedding 服务时自动降级为关键词 2-gram/3-gram 召回。
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# 按实际网关的模型清单填写（本网关可用 qwen3.7-text-embedding-flash，
# 维度 1024）；模型名不匹配时向量建库会静默降级为关键词召回。
# EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# EMBEDDING_DIM=1024

# ===== 向量库 Qdrant（空 = qdrant-client 本地嵌入模式，落盘 DATA_DIR/qdrant） =====
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=leomall_products
CATEGORY_KB_COLLECTION=leomall_category_kb

# ===== Reranker（空 = 降级为按向量分排序，rerank_applied=false） =====
# RERANKER_BASE_URL=
# RERANKER_MODEL=

# ===== 其它可选能力 =====
# TAVILY_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# CORS_ORIGINS=http://localhost:5173
