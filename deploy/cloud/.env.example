# 复制为 .env 后填写；.env 不要提交进版本库
# ===== 必填 =====
# 公网访问入口（IP 或域名，末尾不带 /）：商品图片 URL 会拼上它
PUBLIC_BASE_URL=http://你的服务器IP
# MySQL root 口令（仅容器内部使用）
MYSQL_ROOT_PASSWORD=改成强随机口令
# 应用账号 leomall 的口令：必须与 db/init-sql/leomall.sql 里
# create user 'leomall'@'%' identified by '...' 一致（默认 leomall123456，生产两边一起改）
MYSQL_APP_PASSWORD=leomall123456
# Java BFF 与 Agent 的服务间令牌（两边共用，改成长随机串）
INTERNAL_API_TOKEN=改成强随机口令
# 用户端 JWT 签名密钥（P0-1）：>=32 字符强随机串，必填，缺失后端拒绝启动。
# 生成示例：openssl rand -hex 32
# 注意：更换该值会使所有已登录用户的 token 失效，需重新登录。
LEOMALL_JWT_SECRET=改成至少32字符的强随机串

# ===== 智能导购 Agent =====
# 1 = 本地确定性推荐（无需任何 LLM 密钥，链路可跑通，degraded=true）
# 配好 LLM_API_KEY 后改为 0 启用完整大模型导购
LOCAL_FALLBACK=1
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=控制台确认有效的模型ID
# LLM_FALLBACK_MODEL=备用模型ID
# EMBEDDING_MODEL=text-embedding-v4

# ===== 可选 =====
# JVM 参数（2C4G 机器建议 -Xms256m -Xmx768m）
# JAVA_OPTS=-Xms512m -Xmx1g

# ===== 阶段1：Redis 共享状态（多实例水平扩展前置）=====
# 启用步骤：docker compose --profile cache up -d --build，并取消下面两行注释。
# 开启后验证码/登录锁定/下单去重/领券锁/聊天限流/管理端会话全部跨实例共享。
# LEOMALL_REDIS_ENABLED=true
# REDIS_URL=redis://redis:6379/0
# Redis 设了密码时两边都要配：
# LEOMALL_REDIS_PASSWORD=
# 队列削峰（Agent 意图入队 + worker 消费）：再加 --profile queue 并取消注释
# QUEUE_ENABLED=1
# WORKER_CONCURRENCY=2
# Agent 熔断状态跨实例共享（需 REDIS_URL）
# BREAKER_SHARED=1

# ===== P1-7：第三方凭据（按需填写，不填则对应功能不可用）=====
# 微信小程序 app-secret（启用微信登录/微信支付必填；原演示值已从仓库移除）
# LEOMALL_WX_APP_SECRET=
# 腾讯云 COS 密钥（storage.active=tencent 时必填；原演示值已从仓库移除）
# LEOMALL_COS_SECRET_ID=
# LEOMALL_COS_SECRET_KEY=
# P1-1：跨域来源白名单（逗号分隔）。默认空=不开放跨域；同源部署无需配置
# LEOMALL_CORS_ALLOWED_ORIGINS=https://admin.example.com