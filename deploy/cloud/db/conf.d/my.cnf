# 4C8G 单机的 MySQL 8 保守配置（容器限 1.5G，实际占用约 0.8~1G）
# 2C4G 机器把 innodb_buffer_pool_size 降到 256M
[mysqld]
innodb_buffer_pool_size = 512M
# mysql:8.0 镜像实际版本为 8.0.27，尚不支持 innodb_redo_log_capacity
innodb_log_file_size = 64M
max_connections = 200
performance_schema = OFF
slow_query_log = ON
long_query_time = 2