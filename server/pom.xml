<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.leomall</groupId>
    <artifactId>leomall</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 阶段2B：Boot 3.4.x + Java 17（javax→jakarta）+ Spring Security 6 替代 Shiro -->
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <!-- P3-2：移除全局 maven.test.skip，CI mvn verify 真正执行测试。
             环境依赖型遗留集成测试由 surefire excludes 显式排除（见 build）。 -->
    </properties>

    <modules>
        <module>leomall-core</module>
        <module>leomall-db</module>
        <module>leomall-wx-api</module>
        <module>leomall-admin-api</module>
        <module>leomall-all</module>
        <module>leomall-all-war</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.leomall</groupId>
                <artifactId>leomall-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.leomall</groupId>
                <artifactId>leomall-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.leomall</groupId>
                <artifactId>leomall-wx-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.leomall</groupId>
                <artifactId>leomall-admin-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.leomall</groupId>
                <artifactId>leomall-all</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Boot Mybatis 依赖（阶段2B：Boot 3 对齐 3.0.x） -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>3.0.4</version>
            </dependency>

            <!-- Spring Boot pagehelper 依赖 -->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>2.1.0</version>
            </dependency>

            <!-- 阶段2B：Shiro 移除，认证/授权改 Spring Security 6（Boot BOM 管理版本） -->

            <!-- hibernate-validator 版本交由 Boot BOM 管理（2.7.18 → 6.2.5.Final） -->

            <!-- MySQL 连接驱动（阶段2A：GA 坐标已变更为 com.mysql:mysql-connector-j） -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.4.0</version>
            </dependency>

            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>1.2.23</version>
            </dependency>

            <dependency>
                <groupId>com.github.binarywang</groupId>
                <artifactId>weixin-java-pay</artifactId>
                <version>4.6.0</version>
            </dependency>

            <dependency>
                <groupId>com.github.binarywang</groupId>
                <artifactId>weixin-java-miniapp</artifactId>
                <version>4.6.0</version>
            </dependency>

            <dependency>
                <groupId>com.github.qcloudsms</groupId>
                <artifactId>qcloudsms</artifactId>
                <version>1.0.5</version>
            </dependency>

            <dependency>
                <groupId>com.qcloud</groupId>
                <artifactId>cos_api</artifactId>
                <version>5.6.24</version>
            </dependency>

            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <!-- 阶段2A：2.5.0 过旧（TLS/依赖问题），升 3.17.x -->
                <version>3.17.4</version>
            </dependency>

            <dependency>
                <groupId>com.qiniu</groupId>
                <artifactId>qiniu-java-sdk</artifactId>
                <!-- P3-3：锁定精确版本，消除区间版本导致的不可复现构建 -->
                <version>7.2.29</version>
            </dependency>

            <!-- starter-json / starter-mail 版本交由 Boot BOM 管理，不再硬编码 2.1.5 -->

            <!-- 阶段2B：springdoc 2.x（jakarta / Boot 3）。UI 随包提供 /swagger-ui.html。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>2.8.6</version>
            </dependency>

        <!-- 阶段2B：kaptcha 依赖 javax.servlet，换 hutool-captcha（纯 Java，无 servlet 依赖） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-captcha</artifactId>
            <version>5.8.34</version>
        </dependency>

		<dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.4.8-jre</version>
        </dependency>

            <!-- P2-9：富文本服务端白名单消毒 -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>1.17.2</version>
            </dependency>

            <dependency>
                <groupId>com.auth0</groupId>
                <artifactId>java-jwt</artifactId>
                <!-- P0-1：3.4.1 过旧，升级 4.x（当前用法 API 兼容） -->
                <version>4.4.0</version>
            </dependency>

            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>aliyun-java-sdk-core</artifactId>
                <version>4.0.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- 测试模块 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- P3-9/阶段2B：powermock/mockito1.x 已移除；测试已全量迁 JUnit5，
             vintage 引擎随之移除，mockito 由 Boot 3 BOM 管理（5.x）。 -->
    </dependencies>

    <profiles>
        <!-- P3-4：devtools 仅在显式 -Pdevtools 时引入，不再进入所有模块与生产制品 -->
        <profile>
            <id>devtools</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-devtools</artifactId>
                    <optional>true</optional>
                </dependency>
            </dependencies>
        </profile>
    </profiles>


    <build>
        <plugins>
            <!-- 阶段2A：compiler 插件版本交由 Boot 父 POM 管理（3.10.1），
                 source/target 由 java.version=1.8 属性决定 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- P3-2：以下为 litemall 遗留的环境依赖型集成测试（需 MySQL/
                         外部服务/真实凭据），CI 不运行；本地按需运行：
                         mvn test -Dtest=DbTest（-Dtest 会覆盖 excludes）。
                         纯单元测试与新增安全回归测试正常执行。 -->
                    <excludes>
                        <exclude>**/AdminConfigTest.java</exclude>
                        <exclude>**/BcryptTest.java</exclude>
                        <exclude>**/CreateShareImageTest.java</exclude>
                        <exclude>**/DbTest.java</exclude>
                        <exclude>**/PermissionTest.java</exclude>
                        <exclude>**/AllinoneConfigTest.java</exclude>
                        <exclude>**/AliyunStorageTest.java</exclude>
                        <exclude>**/AsyncTest.java</exclude>
                        <exclude>**/CoreConfigTest.java</exclude>
                        <exclude>**/ExpressTest.java</exclude>
                        <exclude>**/LocalStorageTest.java</exclude>
                        <exclude>**/MailTest.java</exclude>
                        <exclude>**/QiniuStorageTest.java</exclude>
                        <exclude>**/SmsTest.java</exclude>
                        <exclude>**/TaskTest.java</exclude>
                        <exclude>**/TencentStorageTest.java</exclude>
                        <exclude>**/DbConfigTest.java</exclude>
                        <exclude>**/DbUtilTest.java</exclude>
                        <exclude>**/MapperReturnTest.java</exclude>
                        <exclude>**/StatMapperTest.java</exclude>
                        <exclude>**/StockTest.java</exclude>
                        <exclude>**/WxConfigTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>